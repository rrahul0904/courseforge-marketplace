{
  "name": "courseforge-marketplace",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma generate && node --experimental-strip-types prisma/seed.ts",
    "db:verify": "prisma generate && node --experimental-strip-types scripts/verify-db.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "next": "16.3.3",
    "pg": "^8.16.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "dotenv": "^17.2.2",
    "eslint": "^9.34.0",
    "eslint-config-next": "16.3.3",
    "prisma": "7.10.0",
    "typescript": "^5.9.2"
  }
}
